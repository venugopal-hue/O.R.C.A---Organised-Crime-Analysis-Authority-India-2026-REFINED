# ── Firebase Client SDK (Public) ───────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=orca-india2026.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=orca-india2026
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=orca-india2026.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ── Firebase Admin SDK (Server-Side ONLY - Secrets) ───────────────
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"orca-india2026"}

# ── AI Model API Keys (Server-Side ONLY - Secrets) ────────────────
GROQ_API_KEY=your_groq_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here

# ── Gateway Connection (Optional) ──────────────────────────────────
NEXT_PUBLIC_FASTAPI_API_URL=http://localhost:8000/api/v1

# ── Sarvam AI (optional) ────────────────────────────────────────────────────
# Kannada text-to-speech and Indian-hosted speech-to-text. Tried in order;
# empty slots are skipped. Values are never sent to the browser.
SARVAM_API_KEY_1=
SARVAM_API_KEY_2=
SARVAM_API_KEY_3=
SARVAM_API_KEY_4=
