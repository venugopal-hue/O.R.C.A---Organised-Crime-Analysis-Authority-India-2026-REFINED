rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS — O.R.C.A 5-ROLE RBAC SYSTEM
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Returns the officer's ISD clearance level from custom claims
    function isdLevel() {
      return request.auth.token.isdLevel;
    }

    // Returns the officer's dashboard role from custom claims
    function dashRole() {
      return request.auth.token.dashboardRole;
    }

    // Any authenticated officer with any administrative role
    function isAdmin() {
      return isAuthenticated() && (
        dashRole() == "admin_full" ||
        dashRole() == "admin_scrb" ||
        dashRole() == "admin_verification" ||
        dashRole() == "admin_l1" ||
        dashRole() == "admin_l2" ||
        isdLevel() == "ISD-LEVEL-I" ||
        isdLevel() == "ISD-LEVEL-II"
      );
    }

    // Only the top executive admins (can modify roles, approve registrations)
    function isExecutiveAdmin() {
      return isAuthenticated() && (
        dashRole() == "admin_full" ||
        dashRole() == "admin_scrb" ||
        isdLevel() == "ISD-LEVEL-I"
      );
    }


    // =========================================================================
    // 1. FORENSIC EVIDENCE — Officers + Admin read; only Admin can write
    // =========================================================================
    match /forensic_evidence/{doc} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // =========================================================================
    // 2. AUDIT TRAILS & LOGS — All authenticated can read; only system writes
    //    (system writes use Admin SDK which bypasses these rules)
    // =========================================================================
    match /audit_trails/{doc} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isExecutiveAdmin();
    }

    match /audit_logs/{doc} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isExecutiveAdmin();
    }

    match /roleChangeLog/{doc} {
      allow read: if isAdmin();
      allow create: if isExecutiveAdmin();
      allow update, delete: if false; // Immutable log — never update/delete
    }

    // =========================================================================
    // 3. ADMIN SETTINGS & CONFIGURATIONS — Executive admins only
    // =========================================================================
    match /admin_settings/{doc} {
      allow read: if isAdmin();
      allow write: if isExecutiveAdmin();
    }

    match /system_settings/{doc} {
      allow read: if isAdmin();
      allow write: if isExecutiveAdmin();
    }

    // =========================================================================
    // 4. USERS — Own document + admin access
    // =========================================================================
    match /users/{uid} {
      // Officers can read their own profile; admins can read all
      allow read: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      // Officers can update their own non-sensitive fields; only admin can update role/clearance
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        request.auth.uid == uid &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(
          ["dashboardRole", "isdLevel", "clearanceLevel", "role", "active"]
        )
      );
      allow delete: if isExecutiveAdmin();

      match /conversations/{convId} {
        allow read, write: if isAuthenticated() && request.auth.uid == uid;
      }
    }

    // =========================================================================
    // 5. OFFICERS DIRECTORY — Authenticated read; admin write
    // =========================================================================
    match /officers/{uid} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isExecutiveAdmin();
    }

    // =========================================================================
    // 6. CASES, DOCUMENTS & OCR LOGS
    // =========================================================================
    match /cases/{doc} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); // Officers file/update cases
    }

    match /verified_documents/{doc} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /ocr_logs/{doc} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isExecutiveAdmin();
    }

    // =========================================================================
    // 7. REGISTRATIONS & APPLICATIONS
    // =========================================================================
    match /pendingRegistrations/{uid} {
      // Anyone authenticated can submit their own registration
      allow create: if isAuthenticated() && request.auth.uid == uid;
      // Admins can read and update (approve/reject)
      allow read, update, delete: if isAdmin();
    }

    match /officer_applications/{uid} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }

    // =========================================================================
    // FALLBACK — Deny all other access (secure by default)
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
